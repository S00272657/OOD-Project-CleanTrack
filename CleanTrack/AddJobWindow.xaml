<Window x:Class="CleanTrack.AddJobWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Add Job" Height="800" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Job Type -->
        <ComboBox x:Name="cbxJobType" Grid.Row="0" Margin="0,0,0,12"
                  materialDesign:HintAssist.Hint="Job Type *"
                  Style="{StaticResource MaterialDesignOutlinedComboBox}">
            <ComboBoxItem Content="House Cleaning"/>
            <ComboBoxItem Content="Window Cleaning"/>
            <ComboBoxItem Content="Carpet Cleaning"/>
            <ComboBoxItem Content="Upholstery Cleaning"/>
            <ComboBoxItem Content="After-Builder Cleaning"/>
        </ComboBox>

        <!-- Client -->
        <ComboBox x:Name="cbxClient" Grid.Row="1" Margin="0,0,0,12"
                  materialDesign:HintAssist.Hint="Client *"
                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                  DisplayMemberPath="FullName"/>

        <!-- Address -->
        <TextBox x:Name="tbxAddress" Grid.Row="2" Margin="0,0,0,12"
                 materialDesign:HintAssist.Hint="Address *"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

        <!-- Date -->
        <DatePicker x:Name="dpJobDate" Grid.Row="3" Margin="0,0,0,12"
                    materialDesign:HintAssist.Hint="Date *"
                    Style="{StaticResource MaterialDesignOutlinedDatePicker}"/>

        <!-- Price -->
        <TextBox x:Name="tbxPrice" Grid.Row="4" Margin="0,0,0,12"
                 materialDesign:HintAssist.Hint="Price (€) *"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

        <!-- Time Taken -->
        <TextBox x:Name="tbxTimeTaken" Grid.Row="5" Margin="0,0,0,12"
                 materialDesign:HintAssist.Hint="Time Taken"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

        <!-- Status -->
        <ComboBox x:Name="cbxStatus" Grid.Row="6" Margin="0,0,0,12"
                  materialDesign:HintAssist.Hint="Status *"
                  Style="{StaticResource MaterialDesignOutlinedComboBox}">
            <ComboBoxItem Content="Scheduled"/>
            <ComboBoxItem Content="In Progress"/>
            <ComboBoxItem Content="Completed"/>
            <ComboBoxItem Content="Cancelled"/>
        </ComboBox>

        <!-- Description -->
        <TextBox x:Name="tbxDescription" Grid.Row="7" Margin="0,0,0,12"
                 materialDesign:HintAssist.Hint="Description"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 AcceptsReturn="True" Height="60" TextWrapping="Wrap"/>

        <!-- Employees Checklist -->
        <GroupBox Grid.Row="8" Header="Assign Employees" Margin="0,0,0,12">
            <ListBox x:Name="lbxEmployees" MaxHeight="120"
                     SelectionMode="Multiple">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding FullName}"
                                  IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </GroupBox>

        <!-- Buttons -->
        <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnCancel" Content="Cancel" Margin="0,0,8,0"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Click="btnCancel_Click"/>
            <Button x:Name="btnSave" Content="Save Job"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Click="btnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>