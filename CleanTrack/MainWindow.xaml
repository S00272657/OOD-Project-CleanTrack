<Window x:Name="MainWindow1" x:Class="CleanTrack.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CleanTrack"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="CleanTrack" Height="600" Width="1150" Loaded="MainWindow1_Loaded">


    <TabControl x:Name="tcMain" SelectionChanged="tcMain_SelectionChanged">

        <!-- JOBS -->
        <TabItem Name="Jobs" Header="Jobs" Width="Auto">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!--TOP ROW - search & filter & date range -->
                <WrapPanel Orientation="Horizontal" Grid.Row="0" HorizontalAlignment="Left">
                    <TextBox x:Name="tbxSearchJobs" Width="200" Margin="0,0,8,8"
                         materialDesign:HintAssist.Hint="Search jobs..."
                         Style="{StaticResource MaterialDesignOutlinedTextBox}" TextChanged="tbxSearchJobs_TextChanged"/>

                    <!--job status filter-->
                    <ComboBox x:Name="cbxStatusFilter" Width="150" Margin="0,0,8,8"
                          materialDesign:HintAssist.Hint="Status"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}" SelectionChanged="cbxStatusFilter_SelectionChanged">
                        <ComboBoxItem Content="All"/>
                        <ComboBoxItem Content="Scheduled"/>
                        <ComboBoxItem Content="In Progress"/>
                        <ComboBoxItem Content="Completed"/>
                        <ComboBoxItem Content="Cancelled"/>
                    </ComboBox>
                    <!--job type filter-->
                    <ComboBox x:Name="cbxJobTypeFilter" Width="150" Margin="0,0,8,8"
                          materialDesign:HintAssist.Hint="Job Type"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}" SelectionChanged="cbxJobTypeFilter_SelectionChanged">
                        <ComboBoxItem Content="All"/>
                        <ComboBoxItem Content="House Cleaning"/>
                        <ComboBoxItem Content="Window Cleaning"/>
                        <ComboBoxItem Content="Upholstery Cleaning"/>
                        <ComboBoxItem Content="After-Builder Cleaning"/>
                    </ComboBox>
                    <!--employee filter-->
                    <ComboBox x:Name="cbxEmployeeFilter" Width="150" Margin="0,0,8,8"
                          materialDesign:HintAssist.Hint="Employee"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}" SelectionChanged="cbxEmployeeFilter_SelectionChanged">
                        <ComboBoxItem Content="All"/>
                    </ComboBox>

                    <!--date range (FROM)-->
                    <DatePicker x:Name="dpFromDateFilter" Width="150" Margin="0,0,8,8"
                            materialDesign:HintAssist.Hint="From"
                            Style="{StaticResource MaterialDesignOutlinedDatePicker}" SelectedDateChanged="dpFromDateFilter_SelectedDateChanged"/>

                    <!--date range (TO)-->
                    <DatePicker x:Name="dpToDateFilter" Width="150" Margin="0,0,8,8"
                        materialDesign:HintAssist.Hint="To"
                        Style="{StaticResource MaterialDesignOutlinedDatePicker}" SelectedDateChanged="dpToDateFilter_SelectedDateChanged"/>

                    <Button x:Name="btnResetJobFilters" Content="Reset Filters" Margin="0,0,8,8" Click="btnResetJobFilters_Click" VerticalAlignment="Center"/>

                </WrapPanel>

                <!--MAIN SECTION - list of results -->
                <DataGrid x:Name="dgJobs" Grid.Row="2" Margin="0,0,0,8"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=dd/MM/yyyy}" Width="Auto"/>
                        <DataGridTextColumn Header="Job Type" Binding="{Binding JobType}" Width="Auto"/>
                        <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=€{0:F2}}" Width="Auto"/>
                        <DataGridTextColumn Header="Client" Binding="{Binding Client.FullName}" Width="Auto"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto"/>
                        <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="Auto"/>
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="Auto"/>
                        <DataGridTextColumn Header="Time taken" Binding="{Binding TimeTaken}" Width="Auto"/>
                        <DataGridTextColumn Header="Assigned Employees" Binding="{Binding AssignedEmployees}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!--BOTTOM ROW - action buttons - add/edit/delete/view details/summary-->
                <StackPanel Grid.Row="3" Orientation="Horizontal">
                    <Button x:Name="btnAddJob" Content="Add Job" Margin="0,0,8,0" Click="btnAddJob_Click"></Button>
                    <Button x:Name="btnEditJob" Content="Edit" Margin="0,0,8,0" Click="btnEditJob_Click"
                            Style="{StaticResource MaterialDesignOutlinedButton}"/>
                    <Button x:Name="btnDeleteJob" Content="Delete" Margin="0,0,8,0" Background="#FF9E0808" Click="btnDeleteJob_Click" BorderBrush="#FF9E0808"/>
                    <Button x:Name="btnViewJobDetails" Content="View Details" Margin="0,0,8,0" Click="btnViewJobDetails_Click"></Button>
                    

                </StackPanel>
            </Grid>
        </TabItem>
        
        <!-- CLIENTS -->
        <TabItem Name="Clients" Header="Clients" Width="Auto">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!--TOP ROW - search & filter  -->
                <StackPanel Orientation="Horizontal" Grid.Row="0" HorizontalAlignment="Left">
                    <TextBox x:Name="tbxSearchClients" Width="200" Margin="0,0,8,8"
                             materialDesign:HintAssist.Hint="Search Clients..."
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             TextChanged="tbxSearchClients_TextChanged"/>

                    <!--active status filter-->
                    <ComboBox x:Name="cbxClientActiveFilter" Width="150" Margin="0,0,8,8"
                              materialDesign:HintAssist.Hint="Status"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              SelectionChanged="cbxClientActiveFilter_SelectionChanged">
                        <ComboBoxItem Content="All" IsSelected="True"/>
                        <ComboBoxItem Content="Active"/>
                        <ComboBoxItem Content="Inactive"/>
                    </ComboBox>
                </StackPanel>

                <!--MAIN SECTION - List of results -->
                <DataGrid x:Name="dgClients" Grid.Row="2" Margin="0,0,0,8"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    IsReadOnly="True">  
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding FullName}" Width="Auto"/>
                        <DataGridTextColumn Header="Phone" Binding="{Binding PhoneNumber}" Width="Auto"/>
                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="Auto"/>
                        <DataGridTextColumn Header="Eircode" Binding="{Binding Eircode}" Width="Auto"/>
                        <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="Auto"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!--BOTTOM ROW - action buttons - add/edit/delete/view details/customer count-->
                <StackPanel Grid.Row="3" Orientation="Horizontal">
                    <Button Content="New Client" Margin="0,0,8,0" Click="btnAddClient_Click"/>
                    <Button Content="Edit" Margin="0,0,8,0" Style="{StaticResource MaterialDesignOutlinedButton}" Click="btnEditClient_Click"/>
                    <Button Content="Delete" Margin="0,0,8,0" Background="#FF9E0808" BorderBrush="#FF9E0808" Click="btnDeleteClient_Click"/>
                    <Button Content="View Details" Margin="0,0,8,0" Click="btnViewClientDetails_Click"/>
                </StackPanel>
            </Grid>

        </TabItem>

        <!-- EMPLOYEES -->
        <TabItem Name="Employees" Header="Employees" Width="Auto">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- TOP ROW - search & filters -->
                <WrapPanel Orientation="Horizontal" Grid.Row="0" HorizontalAlignment="Left">
                    <TextBox x:Name="tbxSearchEmployees" Width="200" Margin="0,0,8,8"
                         materialDesign:HintAssist.Hint="Search employees..."
                         Style="{StaticResource MaterialDesignOutlinedTextBox}" SelectionChanged="tbxSearchEmployees_SelectionChanged" />

                    <ComboBox x:Name="cbxRoleFilter" Width="150" Margin="0,0,8,8"
                          materialDesign:HintAssist.Hint="Role"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}" SelectionChanged="cbxRoleFilter_SelectionChanged">
                        <ComboBoxItem Content="All"/>
                        <ComboBoxItem Content="Cleaner"/>
                        <ComboBoxItem Content="Supervisor"/>
                    </ComboBox>

                    <ComboBox x:Name="cbxActiveFilter" Width="150" Margin="0,0,8,8"
                          materialDesign:HintAssist.Hint="Status"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}" SelectionChanged="cbxActiveFilter_SelectionChanged"
                         >
                        <ComboBoxItem Content="All"/>
                        <ComboBoxItem Content="Active"/>
                        <ComboBoxItem Content="Inactive"/>
                    </ComboBox>

                    <Button x:Name="btnResetEmployeeFilters" Content="Reset Filters" Margin="0,0,8,8"
                        Style="{StaticResource MaterialDesignOutlinedButton}" Click="btnResetEmployeeFilters_Click"
                        />
                </WrapPanel>

                <!-- MAIN SECTION - DataGrid -->
                <DataGrid x:Name="dgEmployees" Grid.Row="1" Margin="0,0,0,8"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding FullName}" Width="150"/>
                        <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="100"/>
                        <DataGridTextColumn Header="Phone" Binding="{Binding PhoneNumber}" Width="120"/>
                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                        <DataGridTextColumn Header="Start Date" Binding="{Binding StartDate, StringFormat=dd/MM/yyyy}" Width="100"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding ActiveStatus}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- BOTTOM ROW - action buttons -->
                <StackPanel Grid.Row="2" Orientation="Horizontal">
                    <Button x:Name="btnAddEmployee" Content="Add Employee" Margin="0,0,8,0" Click="btnAddEmployee_Click"/>
                    <Button x:Name="btnEditEmployee" Content="Edit" Margin="0,0,8,0"
                        Style="{StaticResource MaterialDesignOutlinedButton}" Click="btnEditEmployee_Click"/>
                    <Button x:Name="btnDeleteEmployee" Content="Delete" Margin="0,0,8,0"
                        Background="#FF9E0808" BorderBrush="#FF9E0808" Click="btnDeleteEmployee_Click"/>
                    <Button x:Name="btnViewEmployeeDetails" Content="View Details" Margin="0,0,8,0" Click="btnViewEmployeeDetails_Click"/>
                </StackPanel>
            </Grid>
        </TabItem>

        <!-- CALENDAR -->
        <TabItem Name="Calendar" Header="Calendar" Width="Auto">
            <Grid Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Calendar control -->
                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                    <Calendar x:Name="calMain" SelectionMode="SingleDate"
                              SelectedDatesChanged="calMain_SelectedDatesChanged"/>
                    <TextBlock x:Name="tbxCalendarJobCount" Margin="0,8,0,0"
                               FontSize="13" Foreground="Gray" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Right: Jobs for selected date -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="tbxCalendarDate" Grid.Row="0"
                               FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"
                               Text="Select a date to view jobs"/>

                    <DataGrid x:Name="dgCalendarJobs" Grid.Row="1"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Job Type" Binding="{Binding JobType}" Width="Auto"/>
                            <DataGridTextColumn Header="Client" Binding="{Binding Client.FullName}" Width="Auto"/>
                            <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="*"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto"/>
                            <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=€{0:F2}}" Width="Auto"/>
                            <DataGridTextColumn Header="Employees" Binding="{Binding AssignedEmployees}" Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </TabItem>

        <!-- REPORTS -->
        <TabItem Name="Reports" Header="Reports" Width="Auto">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Summary stats -->
                <Border Grid.Row="0" Background="#6A1B9A" CornerRadius="8" Padding="20,14" Margin="0,0,0,16">
                    <WrapPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,40,0">
                            <TextBlock Text="Total Revenue (Completed)" FontWeight="SemiBold" Foreground="White"/>
                            <TextBlock x:Name="txtTotalRevenue" FontSize="16" Margin="0,2,0,0" Foreground="White"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,40,0">
                            <TextBlock Text="Jobs This Month" FontWeight="SemiBold" Foreground="White"/>
                            <TextBlock x:Name="txtJobsThisMonth" FontSize="16" Margin="0,2,0,0" Foreground="White"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,40,0">
                            <TextBlock Text="Active Clients" FontWeight="SemiBold" Foreground="White"/>
                            <TextBlock x:Name="txtActiveClients" FontSize="16" Margin="0,2,0,0" Foreground="White"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Top Job Type" FontWeight="SemiBold" Foreground="White"/>
                            <TextBlock x:Name="txtTopJobType" FontSize="16" Margin="0,2,0,0" Foreground="White"/>
                        </StackPanel>
                    </WrapPanel>
                </Border>

                <!--  Monthly | Weekly -->
                <Grid Grid.Row="1" Grid.RowSpan="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: Monthly breakdown -->
                    <Grid Grid.Row="0" Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Monthly Breakdown" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <DataGrid x:Name="dgMonthlyRevenue" Grid.Row="1"
                                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Month"   Binding="{Binding Month}"       Width="*"/>
                                <DataGridTextColumn Header="Jobs"    Binding="{Binding JobCount}"     Width="60"/>
                                <DataGridTextColumn Header="Revenue" Binding="{Binding TotalRevenue, StringFormat=€{0:F2}}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <!-- RIGHT: Weekly summary -->
                    <Grid Grid.Row="0" Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Weekly Summary" FontWeight="SemiBold" Margin="0,0,0,8"/>

                        <!-- Week navigation -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button x:Name="btnPrevWeek" Content="&lt; Prev" Margin="0,0,8,0"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Click="btnPrevWeek_Click"/>
                            <TextBlock x:Name="txtWeekRange" VerticalAlignment="Center" Margin="4,0"/>
                            <Button x:Name="btnNextWeek" Content="Next &gt;" Margin="8,0,0,0"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Click="btnNextWeek_Click"/>
                        </StackPanel>

                        <!-- Week stats -->
                        <TextBlock x:Name="txtWeekStats" Grid.Row="2" Margin="0,0,0,8"/>

                        <!-- Weekly jobs DataGrid -->
                        <DataGrid x:Name="dgWeeklyJobs" Grid.Row="3"
                                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date"     Binding="{Binding Date, StringFormat=dd/MM/yyyy}" Width="95"/>
                                <DataGridTextColumn Header="Client"   Binding="{Binding Client.FullName}"               Width="*"/>
                                <DataGridTextColumn Header="Job Type" Binding="{Binding JobType}"                       Width="140"/>
                                <DataGridTextColumn Header="Price"    Binding="{Binding Price, StringFormat=€{0:F2}}"   Width="80"/>
                                <DataGridTextColumn Header="Status"   Binding="{Binding Status}"                        Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <!-- Export buttons spans both columns -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="btnExportJSON" Content="Export Monthly to JSON" Click="btnExportJSON_Click" Margin="0,0,8,0"/>
                        <Button x:Name="btnExportWeeklyJSON" Content="Export Weekly to JSON" Click="btnExportWeeklyJSON_Click"
                                Style="{StaticResource MaterialDesignOutlinedButton}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </TabItem>
    </TabControl>
</Window>
