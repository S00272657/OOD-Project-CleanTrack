<Window x:Class="CleanTrack.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CleanTrack"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="CleanTrack" Height="400" Width="800">


    <TabControl>

        <!-- JOBS -->
        <TabItem Name="Jobs" Header="Jobs" Width="Auto">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!--TOP ROW - search & filter & date range -->
                <StackPanel Orientation="Horizontal" Grid.Row="0" HorizontalAlignment="Left">
                    <TextBox Width="200" Margin="0,0,8,8" Text="Search Jobs..."/>

                    <!--job status filter-->
                    <ComboBox Width="150" Margin="0,0,8,8">
                        <ComboBoxItem Content="All"/>
                        <ComboBoxItem Content="Scheduled"/>
                        <ComboBoxItem Content="In Progress"/>
                        <ComboBoxItem Content="Completed"/>
                        <ComboBoxItem Content="Cancelled"/>
                    </ComboBox>
                    <!--job type filter-->
                    <ComboBox Width="150" Margin="0,0,8,8">
                        <ComboBoxItem Content="All"/>
                        <ComboBoxItem Content="House Cleaning"/>
                        <ComboBoxItem Content="Window Cleaning"/>
                        <ComboBoxItem Content="Upholstery Cleaning"/>
                        <ComboBoxItem Content="After-Builder Cleaning"/>
                    </ComboBox>
                    <!--employee filter-->
                    <ComboBox Width="150" Margin="0,0,8,8">
                        <ComboBoxItem Content="All"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Left">
                    <!--date range (FROM)-->
                    <Label>From:</Label>
                    <DatePicker Width="150" Margin="0,0,8,8"/>

                    <!--date range (TO)-->
                    <Label>To:</Label>
                    <DatePicker Width="150" Margin="0,0,8,8"/>

                </StackPanel>

                <!--MAIN SECTION - List of results -->
                <ListBox x:Name="lbxJobs" Grid.Row="2" Margin="0,0,0,8"/>

                <!--BOTTOM ROW - action buttons - add/edit/delete/view details/summary-->
                <StackPanel Grid.Row="3" Orientation="Horizontal">
                    <Button Content="Add Job" Margin="0,0,8,0"></Button>
                    <Button Content="Edit" Margin="0,0,8,0"></Button>
                    <Button Content="Delete" Margin="0,0,8,0" Background="#FF9E0808"/>
                    <Button Content="View Details"></Button>
                </StackPanel>
            </Grid>
        </TabItem>
        
        <!-- CLIENTS -->
        <TabItem Name="Clients" Header="Clients" Width="Auto">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!--TOP ROW - search & filter  -->
                <StackPanel Orientation="Horizontal" Grid.Row="0" HorizontalAlignment="Left">
                    <TextBox Width="200" Margin="0,0,8,8" Text="Search Clients..."/>

                    <!--job type filter-->
                    <ComboBox Width="150" Margin="0,0,8,8">
                        <ComboBoxItem Content="All"/>
                        <ComboBoxItem Content="Scheduled"/>
                        <ComboBoxItem Content="In Progress"/>
                        <ComboBoxItem Content="Completed"/>
                        <ComboBoxItem Content="Cancelled"/>
                    </ComboBox>
                </StackPanel>

                <!--MAIN SECTION - List of results -->
                <ListBox x:Name="lbxClients" Grid.Row="2" Margin="0,0,0,8"/>

                <!--BOTTOM ROW - action buttons - add/edit/delete/view details/customer count-->
                <StackPanel Grid.Row="3" Orientation="Horizontal">
                    <Button Content="New Client" Margin="0,0,8,0"></Button>
                    <Button Content="Edit" Margin="0,0,8,0"></Button>
                    <Button Content="Delete" Margin="0,0,8,0" Background="#FF9E0808"/>
                    <Button Content="View Details"></Button>
                </StackPanel>
            </Grid>

        </TabItem>

        <!-- EMPLOYEES -->
        <TabItem Name="Employees" Header="Employees" Width="Auto">

        </TabItem>

        <!-- CALENDAR -->
        <TabItem Name="Calendar" Header="Calendar" Width="Auto">

        </TabItem>

        <!-- REPORTTS -->
        <TabItem Name="Reports" Header="Reports" Width="Auto">

        </TabItem>
    </TabControl>
</Window>
