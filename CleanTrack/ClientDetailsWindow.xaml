<Window x:Class="CleanTrack.ClientDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Client Details" Height="450" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <ScrollViewer Margin="16" VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <GroupBox Header="Client Details" Margin="0,0,0,16">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:"       FontWeight="Bold" Margin="0,4"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="txtName"   Margin="0,4"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Phone:"      FontWeight="Bold" Margin="0,4"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="txtPhone"  Margin="0,4"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Email:"      FontWeight="Bold" Margin="0,4"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="txtEmail"  Margin="0,4"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Address:"    FontWeight="Bold" Margin="0,4"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="txtAddress" Margin="0,4"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="City:"       FontWeight="Bold" Margin="0,4"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="txtCity"   Margin="0,4"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Eircode:"    FontWeight="Bold" Margin="0,4"/>
                    <TextBlock Grid.Row="5" Grid.Column="1" x:Name="txtEircode" Margin="0,4"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Status:"     FontWeight="Bold" Margin="0,4"/>
                    <TextBlock Grid.Row="6" Grid.Column="1" x:Name="txtStatus" Margin="0,4"/>
                </Grid>
            </GroupBox>

            <Button Content="Close" HorizontalAlignment="Right"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Click="btnClose_Click"/>

        </StackPanel>
    </ScrollViewer>
</Window>
